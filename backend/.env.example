# PostgreSQL (required). On the company server this is the production database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Fastify listen address. Keep HOST=127.0.0.1 when nginx terminates TLS.
HOST="127.0.0.1"
PORT="4000"

# Comma-separated browser origins allowed to call the API with credentials.
# Never use *. Local Next.js stays on http://localhost:3000.
CORS_ORIGINS="http://localhost:3000"

# Production cookie Domain, e.g. .example.com. Leave empty on localhost.
# COOKIE_DOMAIN=".example.com"

# Session and evidence HMAC signing. Required for Phase 2 auth; optional for the Phase 1 skeleton.
# AUTH_SECRET="generate-a-long-random-string"

# Used when running verify-flow against a local Next.js server.
# BASE_URL="http://localhost:3000"

# Uploaded evidence and logos. Relative paths resolve from the backend working directory.
STORAGE_ROOT="../storage"

# Optional: allow public sign-up. Default is off.
# PUBLIC_SIGNUP=true

# Optional: Chromium/Chrome path used by /ready and later PDF export.
# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
