{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "server.ts",
    "app.ts",
    "config/**/*.ts",
    "plugins/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  }
}
