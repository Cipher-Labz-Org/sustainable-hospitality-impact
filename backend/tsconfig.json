{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "@/backend/*": ["./*"]
    }
  },
  "include": [
    "server.ts",
    "app.ts",
    "config/**/*.ts",
    "plugins/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
