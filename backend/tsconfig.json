{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/backend/*": ["./*"]
    }
  },
  "exclude": ["dist", "node_modules"],
  "include": [
    "server.ts",
    "app.ts",
    "config/**/*.ts",
    "plugins/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ]
}
