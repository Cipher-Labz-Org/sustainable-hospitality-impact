# PostgreSQL (required). In production this should be the company-hosted database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js session signing (required)
AUTH_SECRET="generate-a-long-random-string"

# Canonical site URL (required in production for Auth.js callbacks and share links)
# AUTH_URL="https://your-frontend-domain.com"
# NEXT_PUBLIC_APP_URL="https://your-frontend-domain.com"

# Optional: allow public sign-up at /signup
# PUBLIC_SIGNUP=true

# Uploaded evidence and logos. Relative paths resolve from the Next.js working directory (frontend/).
STORAGE_ROOT="../storage"

# Optional: override Chrome/Chromium used for PDF export. Unset on Vercel (uses @sparticuz/chromium).
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# This app still uses same-origin /api/* Route Handlers and Next.js Server Actions.
# Do not set a separate public API URL until the later cutover phases.
# Local Fastify (Phase 1) listens on http://127.0.0.1:4000 but is unused by this app today.
# NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
