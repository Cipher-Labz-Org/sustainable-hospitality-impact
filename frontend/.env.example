# PostgreSQL (required). In production this should be the company-hosted database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js session signing (required)
AUTH_SECRET="generate-a-long-random-string"

# Canonical site URL (required in production for Auth.js and share links)
# AUTH_URL="https://your-frontend-domain.com"
# NEXT_PUBLIC_APP_URL="https://your-frontend-domain.com"

# Optional: allow public sign-up at /signup
# PUBLIC_SIGNUP=true

# Uploaded evidence and logos. Relative paths resolve from the Next.js working directory (frontend/).
STORAGE_ROOT="../storage"

# Vercel: skip downloading Chrome during install. PDF export needs Chrome on a host with a writable cache.
# PUPPETEER_SKIP_DOWNLOAD=true

# This app uses same-origin /api/* Route Handlers and Next.js Server Actions.
# Do not set a separate public API URL unless a standalone HTTP backend is introduced.
# NEXT_PUBLIC_API_URL="https://your-production-backend-domain.com"
