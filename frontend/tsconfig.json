{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/frontend/*": ["./*"],
      "@/backend/*": ["../backend/*"],
      "@/*": ["./*"],
      "@prisma/client": ["./node_modules/@prisma/client"],
      "@sparticuz/chromium": ["./node_modules/@sparticuz/chromium"],
      "bcryptjs": ["./node_modules/bcryptjs"],
      "next-auth": ["./node_modules/next-auth"],
      "next-auth/*": ["./node_modules/next-auth/*"],
      "puppeteer-core": ["./node_modules/puppeteer-core"],
      "sharp": ["./node_modules/sharp"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../backend/**/*.ts",
    "../backend/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "../backend/server.ts",
    "../backend/app.ts",
    "../backend/config",
    "../backend/plugins",
    "../backend/routes",
    "../backend/scripts"
  ]
}
