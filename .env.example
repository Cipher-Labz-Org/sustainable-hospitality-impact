# Shared local example. Copy values into frontend/.env and backend/.env.

# PostgreSQL (required)
DATABASE_URL="postgresql://gstc:gstc@localhost:5432/gstc?schema=public"

# Auth.js session signing (required in frontend/.env until Phase 2)
AUTH_SECRET="generate-a-long-random-string"

# Optional: allow public sign-up at /signup
# PUBLIC_SIGNUP=true

# Uploaded evidence and logos (repo-root storage/)
STORAGE_ROOT="../storage"

# Fastify skeleton (backend/.env). The Next.js app does not call this yet.
# HOST="127.0.0.1"
# PORT="4000"
# CORS_ORIGINS="http://localhost:3000"
