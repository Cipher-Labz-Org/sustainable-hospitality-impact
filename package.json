{
  "name": "sustainable-hospitality-impact",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:api": "npm run build --prefix backend",
    "start": "npm run start --prefix frontend",
    "start:api": "npm run start --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend && npm run typecheck --prefix backend",
    "verify:server": "npm run verify:server --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "dev:setup": "npm run db:migrate --prefix backend && npm run db:generate --prefix backend",
    "dev:stack": "npm run dev:setup && npm run dev",
    "user:create": "npm run user:create --prefix backend --",
    "user:admin": "npm run user:admin --prefix backend --",
    "user:password": "npm run user:password --prefix backend --",
    "browsers:install": "npm run browsers:install --prefix frontend"
  }
}
